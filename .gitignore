# Salida de compilación
bin/
obj/

# Carpetas de herramientas
.vs/
.vscode/
*.user
*.suo

# Imágenes de referencia usadas para muestrear colores y medidas.
# Son capturas generadas, no fuentes del proyecto.
*.png
!docs/**/*.png
# Las imágenes aprobadas sí son fuente: son el patrón contra el que compara
# check-render.ps1. Sin ellas la comprobación visual no tiene contra qué medir.
!tools/aprobadas/**/*.png
# Los recortes del catálogo de iconos también: son el material que se está
# revisando, y sin ellos el catálogo abre vacío.
!src/MacOS9.Platinum.Gallery/Recursos/IconosPixel/*.png
