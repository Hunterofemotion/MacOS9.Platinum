<platinum:PlatinumWindow x:Class="MacOS9.Platinum.Gallery.CalibrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:platinum="clr-namespace:MacOS9.Platinum.Controls;assembly=MacOS9.Platinum"
        Title="Calibrate Detector"
        Width="430" SizeToContent="Height"
        ResizeMode="NoResize" ShowGrowBox="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Reference">
            <StackPanel>
                <RadioButton Content="Internal mercury lamp" IsChecked="True" Margin="0,0,0,4" />
                <RadioButton Content="External standard NIST 1155a" Margin="0,0,0,4" />
                <RadioButton Content="Last accepted curve" />
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="Target signal-to-noise" Margin="0,0,0,4" />
            <Slider Minimum="10" Maximum="200" Value="120" TickFrequency="10"
                    TickPlacement="BottomRight" Margin="0,0,0,12" />

            <!-- Fecha y hora: cada tramo se elige con el clic o con las flechas
                 laterales y se cambia con las de arriba y abajo, con las flechitas
                 o tecleando. -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Run at:" VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <platinum:PlatinumDateTimeField DockPanel.Dock="Left" Mode="Date"
                                                Value="2026-08-24T17:00:00"
                                                ToolTip="Click a part and use the arrows." />
                <platinum:PlatinumDateTimeField DockPanel.Dock="Left" Mode="Time"
                                                Value="2026-08-24T17:00:00"
                                                Margin="10,0,0,0" />
                <TextBlock />
            </DockPanel>

            <!-- Duración: hora, minuto y segundo en veinticuatro horas, sin AM ni PM. -->
            <DockPanel Margin="0,10,0,0">
                <TextBlock DockPanel.Dock="Left" Text="Duration:" VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <platinum:PlatinumDateTimeField DockPanel.Dock="Left" Mode="TimeWithSeconds"
                                                Value="2026-08-24T01:00:00" />
                <TextBlock DockPanel.Dock="Left" Text="(hh:mm:ss)" VerticalAlignment="Center"
                           Margin="8,0,0,0" Foreground="{StaticResource TextDisabledBrush}" />
                <TextBlock />
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,12,0,0" VerticalAlignment="Bottom">
            <TextBlock Text="Warming the lamp..." Margin="0,0,0,6" />
            <ProgressBar IsIndeterminate="True" Height="16" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,12,0" IsCancel="True" Click="OnClose" />
            <Button Content="Calibrate" Width="104" IsDefault="True" Click="OnClose" />
        </StackPanel>
    </Grid>
</platinum:PlatinumWindow>
