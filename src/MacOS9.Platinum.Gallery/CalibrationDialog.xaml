<platinum:PlatinumWindow x:Class="MacOS9.Platinum.Gallery.CalibrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:platinum="clr-namespace:MacOS9.Platinum.Controls;assembly=MacOS9.Platinum"
        Title="Calibrate Detector"
        Width="430" Height="286"
        ResizeMode="NoResize" ShowGrowBox="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Reference">
            <StackPanel>
                <RadioButton Content="Internal mercury lamp" IsChecked="True" Margin="0,0,0,4" />
                <RadioButton Content="External standard NIST 1155a" Margin="0,0,0,4" />
                <RadioButton Content="Last accepted curve" />
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="Target signal-to-noise" Margin="0,0,0,4" />
            <Slider Minimum="10" Maximum="200" Value="120" TickFrequency="10"
                    TickPlacement="BottomRight" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,12,0,0" VerticalAlignment="Bottom">
            <TextBlock Text="Warming the lamp..." Margin="0,0,0,6" />
            <ProgressBar IsIndeterminate="True" Height="16" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,12,0" Click="OnClose" />
            <Button Content="Calibrate" Width="104" IsDefault="True" Click="OnClose" />
        </StackPanel>
    </Grid>
</platinum:PlatinumWindow>
