<platinum:PlatinumWindow x:Class="MacOS9.Platinum.Gallery.MathWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:platinum="clr-namespace:MacOS9.Platinum.Controls;assembly=MacOS9.Platinum"
        xmlns:local="clr-namespace:MacOS9.Platinum.Gallery"
        Title="Numerix 4.0"
        Icon="{local:PiezaIcono dato-r4c1}"
        Width="880" Height="600"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="New Worksheet" InputGestureText="Cmd-N" />
                <MenuItem Header="Open..." InputGestureText="Cmd-O" />
                <Separator />
                <MenuItem Header="Export Plot..." />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Undo" InputGestureText="Cmd-Z" />
                <MenuItem Header="Paste Expression" />
            </MenuItem>
            <MenuItem Header="_Solve">
                <MenuItem Header="Find Roots" IsChecked="True" IsCheckable="True" />
                <MenuItem Header="Integrate" IsCheckable="True" />
                <MenuItem Header="Differentiate" IsCheckable="True" />
                <Separator />
                <MenuItem Header="Method">
                    <MenuItem Header="Newton-Raphson" IsChecked="True" IsCheckable="True" />
                    <MenuItem Header="Bisection" IsCheckable="True" />
                    <MenuItem Header="Secant" IsCheckable="True" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Window" />
            <MenuItem Header="_Help" />
        </Menu>

        <ToolBar DockPanel.Dock="Top">
            <platinum:PlatinumToolButton Icon="{local:PiezaIcono base-r1c3}" Text="New" />
            <platinum:PlatinumToolButton Icon="{local:PiezaIcono base-r1c1}" Text="Open" />
            <Separator />
            <platinum:PlatinumToolButton Icon="{local:PiezaIcono dato-r3c4}" Text="Evaluate" />
            <platinum:PlatinumToolButton Icon="{local:PiezaIcono base-r2c1}" Text="Save" />
            <Separator />
            <platinum:PlatinumToolButton Icon="{local:PiezaIcono dato-r4c2}" Text="Residuals"
                                         IsEnabled="False" />
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom" Padding="8,0,26,0">
            <StatusBarItem DockPanel.Dock="Left" MinWidth="230">
                <StackPanel Orientation="Horizontal">
                    <platinum:PlatinumLed VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Converged in 7 iterations." />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="Double precision" />
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" />
            <StatusBarItem>
                <TextBlock Text="Residual 4.1e-12" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                <GroupBox DockPanel.Dock="Bottom" Header="Parameters" Margin="0,10,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="a" Width="20"
                                       VerticalAlignment="Center" />
                            <TextBox DockPanel.Dock="Right" Width="56" Text="1.25" />
                            <Slider Minimum="0" Maximum="4" Value="1.25" Margin="0,0,10,0" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="b" Width="20"
                                       VerticalAlignment="Center" />
                            <TextBox DockPanel.Dock="Right" Width="56" Text="0.40" />
                            <Slider Minimum="0" Maximum="4" Value="0.4" Margin="0,0,10,0" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="n" Width="20"
                                       VerticalAlignment="Center" />
                            <TextBox DockPanel.Dock="Right" Width="56" Text="3.00" />
                            <Slider Minimum="0" Maximum="4" Value="3" Margin="0,0,10,0" />
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <Expander DockPanel.Dock="Bottom" Header="Tolerance" IsExpanded="True"
                          Margin="0,10,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="Absolute"
                                       VerticalAlignment="Center" Width="80" />
                            <TextBox Width="90" HorizontalAlignment="Left" Text="1.0e-10" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Max steps"
                                       VerticalAlignment="Center" Width="80" />
                            <TextBox Width="90" HorizontalAlignment="Left" Text="200" />
                        </DockPanel>
                    </StackPanel>
                </Expander>

                <GroupBox Header="Expressions">
                    <ListView x:Name="Expresiones" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="70"
                                                DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Expression" Width="180"
                                                DisplayMemberBinding="{Binding Body}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </GroupBox>
            </DockPanel>

            <TabControl Grid.Row="0" Grid.Column="1">
                <TabItem Header="Plot">
                    <DockPanel Margin="8">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="Range:"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox DockPanel.Dock="Left" Width="60" Text="-6.28" />
                            <TextBlock DockPanel.Dock="Left" Text="to" VerticalAlignment="Center"
                                       Margin="6,0,6,0" />
                            <TextBox DockPanel.Dock="Left" Width="60" Text="6.28" />
                            <CheckBox DockPanel.Dock="Right" Content="Grid" IsChecked="True" />
                            <TextBlock />
                        </DockPanel>

                        <Border BorderThickness="1" BorderBrush="Black" Background="White">
                            <Canvas x:Name="Lienzo" ClipToBounds="True" />
                        </Border>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Table">
                    <ListView x:Name="Tabla" Margin="8" BorderThickness="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="x" Width="90"
                                                DisplayMemberBinding="{Binding X}" />
                                <GridViewColumn Header="f(x)" Width="110"
                                                DisplayMemberBinding="{Binding Y}" />
                                <GridViewColumn Header="f'(x)" Width="110"
                                                DisplayMemberBinding="{Binding D}" />
                                <GridViewColumn Header="Note" Width="120"
                                                DisplayMemberBinding="{Binding Note}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>

                <TabItem Header="Log">
                    <TextBox Margin="8" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Text="Newton-Raphson, x0 = 1.000000&#x0a;  step 1   x = 1.570796   |f| = 4.2e-01&#x0a;  step 4   x = 2.094395   |f| = 3.7e-05&#x0a;  step 7   x = 2.094395   |f| = 4.1e-12&#x0a;Converged." />
                </TabItem>
            </TabControl>

            <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Text="Root found at x = 2.0943951024" />
                <Button DockPanel.Dock="Right" Content="Solve" Width="104" IsDefault="True" />
                <Button DockPanel.Dock="Right" Content="Reset" Width="90" Margin="0,0,10,0" />
                <TextBlock />
            </DockPanel>
        </Grid>
    </DockPanel>
</platinum:PlatinumWindow>
