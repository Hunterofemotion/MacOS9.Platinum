<platinum:PlatinumWindow x:Class="MacOS9.Platinum.Gallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:platinum="clr-namespace:MacOS9.Platinum.Controls;assembly=MacOS9.Platinum"
        Title="SpectraLab 3.2"
        Width="1000" Height="640"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="New Run" InputGestureText="Cmd-N" />
                <MenuItem Header="Open Method..." InputGestureText="Cmd-O" />
                <Separator />
                <MenuItem Header="Export Results..." Click="OnExport" />
                <MenuItem Header="Print Report" InputGestureText="Cmd-P" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Undo" InputGestureText="Cmd-Z" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Cut" InputGestureText="Cmd-X" />
                <MenuItem Header="Copy" InputGestureText="Cmd-C" />
                <MenuItem Header="Paste" InputGestureText="Cmd-V" />
            </MenuItem>
            <MenuItem Header="_Instrument">
                <MenuItem Header="Connect..." Click="OnInstrument" />
                <MenuItem Header="Calibrate..." Click="OnCalibrate" />
                <Separator />
                <MenuItem Header="Purge Chamber" IsCheckable="True" IsChecked="True" />
                <MenuItem Header="Standby After Run" IsCheckable="True" />
            </MenuItem>
            <MenuItem Header="_Analysis">
                <MenuItem Header="Baseline">
                    <MenuItem Header="None" IsCheckable="True" />
                    <MenuItem Header="Linear" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Polynomial" IsCheckable="True" />
                </MenuItem>
                <MenuItem Header="Peak Search" InputGestureText="Cmd-K" />
            </MenuItem>
            <MenuItem Header="_Window" />
            <MenuItem Header="_Help" />
        </Menu>

        <!-- Barra de herramientas: icono grande y rótulo, con separadores entre
             grupos. Los iconos son los del propio tema. -->
        <ToolBar DockPanel.Dock="Top">
            <platinum:PlatinumToolButton Icon="{StaticResource IconDocument}" Text="New Run"
                                         ToolTip="Starts a fresh acquisition." />
            <platinum:PlatinumToolButton Icon="{StaticResource IconFolder}" Text="Open Method" />
            <Separator />
            <platinum:PlatinumToolButton Icon="{StaticResource IconMagnifier}" Text="Peak Search" />
            <platinum:PlatinumToolButton Icon="{StaticResource IconFloppy}" Text="Save" />
            <Separator />
            <platinum:PlatinumToolButton Icon="{StaticResource IconComputer}" Text="Instrument"
                                         Click="OnInstrument" />
            <platinum:PlatinumToolButton Icon="{StaticResource IconAlert}" Text="Alarms"
                                         IsEnabled="False" />
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom" Padding="8,0,26,0">
            <StatusBarItem DockPanel.Dock="Left" MinWidth="150">
                <TextBlock Text="Ready" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="Detector 21.4 °C" />
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" />
            <StatusBarItem>
                <TextBlock Text="Grating 1800 g/mm · Vacuum nominal" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12,10,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Columna izquierda: árbol de muestras y modo de captura -->
            <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                <GroupBox DockPanel.Dock="Bottom" Header="Acquisition" Margin="0,10,0,0">
                    <StackPanel>
                        <RadioButton Content="Continuous" IsChecked="True" Margin="0,0,0,4"
                                     ToolTip="Reads until you stop the run." />
                        <RadioButton Content="Timed burst" Margin="0,0,0,4" />
                        <RadioButton Content="Triggered" IsEnabled="False" Margin="0,0,0,8"
                                     ToolTip="Needs the external trigger cable." />
                        <Separator Margin="0,0,0,8" />
                        <CheckBox Content="Subtract dark" IsChecked="True" Margin="0,0,0,4" />
                        <CheckBox Content="Auto-integrate" IsChecked="True" Margin="0,0,0,4" />
                        <CheckBox Content="Flag outliers" IsChecked="{x:Null}" />
                    </StackPanel>
                </GroupBox>

                <!-- Paneles plegables: el triángulo del Finder con el título subrayado.
                     Van en el riel izquierdo porque es la lista de arriba la que tiene
                     holgura para cederles alto. -->
                <Expander DockPanel.Dock="Bottom" Header="Sample Info" IsExpanded="True"
                          Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Batch: PX-4471" />
                        <TextBlock Text="Matrix: Aqueous" Margin="0,2,0,0" />
                        <TextBlock Text="Prepared: 12 Nov 2026" Margin="0,2,0,0" />
                    </StackPanel>
                </Expander>

                <Expander DockPanel.Dock="Bottom" Header="Storage" Margin="0,6,0,0">
                    <TextBlock Text="4.3 MB used on disk" />
                </Expander>

                <GroupBox Header="Sample Sets">
                    <TreeView BorderThickness="0">
                        <TreeViewItem Header="Steel Alloys" IsExpanded="True">
                            <TreeViewItem Header="AISI 1045" />
                            <TreeViewItem Header="AISI 4340" />
                            <TreeViewItem Header="Blank" />
                        </TreeViewItem>
                        <TreeViewItem Header="Aluminium" IsExpanded="True">
                            <TreeViewItem Header="6061-T6" />
                            <TreeViewItem Header="7075-T651" />
                        </TreeViewItem>
                        <TreeViewItem Header="Reference Standards">
                            <TreeViewItem Header="NIST 1155a" />
                        </TreeViewItem>
                    </TreeView>
                </GroupBox>
            </DockPanel>

            <!-- Centro: pestañas con la tabla de líneas -->
            <TabControl Grid.Row="0" Grid.Column="1" Margin="0,0,10,0">
                <TabItem Header="Peaks">
                    <DockPanel Margin="8">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="Element:"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox DockPanel.Dock="Left" Width="128" SelectedIndex="0"
                                      ToolTip="Limits the table to one element.">
                                <ComboBoxItem Content="All elements" />
                                <ComboBoxItem Content="Chromium" />
                                <ComboBoxItem Content="Manganese" />
                                <ComboBoxItem Content="Nickel" />
                            </ComboBox>
                            <TextBox x:Name="SampleField" Margin="10,0,0,0" Text="Run 0412-B" />
                        </DockPanel>

                        <ListView ItemsSource="{Binding Lines}"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Line" Width="88"
                                                    DisplayMemberBinding="{Binding Line}" />
                                    <GridViewColumn Header="Element" Width="84"
                                                    DisplayMemberBinding="{Binding Element}" />
                                    <GridViewColumn Header="Wavelength" Width="104"
                                                    DisplayMemberBinding="{Binding Wavelength}" />
                                    <GridViewColumn Header="Intensity" Width="88"
                                                    DisplayMemberBinding="{Binding Intensity}" />
                                    <GridViewColumn Header="Status" Width="96"
                                                    DisplayMemberBinding="{Binding Status}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Spectrum">
                    <StackPanel Margin="14">
                        <TextBlock Text="Nothing plotted yet. Start a run to see the trace."
                                   Margin="0,0,0,12" />
                        <TextBlock Text="Wavelength window" Margin="0,0,0,4" />
                        <Slider Minimum="180" Maximum="800" Value="404" TickFrequency="100"
                                TickPlacement="BottomRight" Margin="0,0,0,12" />
                        <TextBlock Text="Smoothing" Margin="0,0,0,4" />
                        <Slider Minimum="0" Maximum="10" Value="3" TickFrequency="1"
                                TickPlacement="BottomRight" IsEnabled="False" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="Notes">
                    <DockPanel Margin="8">
                        <TextBlock DockPanel.Dock="Top" Text="Operator notes for this run"
                                   Margin="0,0,0,6" />
                        <!-- Área de texto: varias líneas, el texto arranca arriba y la
                             barra aparece sola cuando el contenido no cabe. De alto
                             fijo, como el cuadro de notas del modelo. -->
                        <!-- Cuadro y franja de números comparten un solo pozo: el
                             marco lo dibuja el chrome y el campo va sin el suyo. -->
                        <ContentControl DockPanel.Dock="Top" Height="150"
                                        Template="{StaticResource PlatinumWellChrome}">
                            <DockPanel>
                                <platinum:PlatinumLineGutter DockPanel.Dock="Left"
                                                             Target="{Binding ElementName=Notas}" />
                                <TextBox x:Name="Notas"
                                 AcceptsReturn="True"
                                 Style="{StaticResource PlatinumTextBoxPlain}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="Chamber purged twice before the run. The 403 nm manganese line came in weak again, same as last week; worth checking the lamp alignment before trusting the manganese numbers.&#x0a;&#x0a;Iron saturated at 372 nm, as expected for this alloy. The chromium pair at 267 and 283 nm agreed within 2 percent, so the calibration from Tuesday still holds.&#x0a;&#x0a;Nickel at 352 nm fell below the detection limit. That line is always marginal on this grating; the 341 nm line is the one to quote.&#x0a;&#x0a;Lamp has 340 hours on it. Replacement is due before the next batch of aluminium standards." />
                            </DockPanel>
                        </ContentControl>

                        <TextBlock DockPanel.Dock="Top" Margin="0,10,0,0"
                                   Text="Notes travel with the run and end up in the exported report." />
                        <TextBlock />
                    </DockPanel>
                </TabItem>

                <TabItem Header="Log">
                    <TextBox Margin="8" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Text="09:41:02  Chamber purge started&#x0a;09:41:38  Vacuum nominal&#x0a;09:42:04  Lamp warm-up complete&#x0a;09:42:11  Grating homed at 1800 g/mm&#x0a;09:42:15  Ready" />
                </TabItem>
            </TabControl>

            <!-- Columna derecha: detector y mandos -->
            <DockPanel Grid.Row="0" Grid.Column="2">
                <GroupBox DockPanel.Dock="Top" Header="Detector">
                    <StackPanel>
                        <TextBlock Text="Grating" Margin="0,0,0,4" />
                        <ComboBox SelectedIndex="1" Margin="0,0,0,10">
                            <ComboBoxItem Content="600 g/mm" />
                            <ComboBoxItem Content="1800 g/mm" />
                            <ComboBoxItem Content="2400 g/mm" />
                        </ComboBox>

                        <TextBlock Text="Photomultiplier gain" Margin="0,0,0,4" />
                        <Slider Minimum="0" Maximum="100" Value="62" Margin="0,0,0,10" />

                        <TextBlock Text="Integration (ms)" Margin="0,0,0,4" />
                        <TextBox Text="250" Margin="0,0,0,10" />

                        <!-- Modo Zones: en una presión de cámara lo que importa es
                             en qué franja está, y verlas todas evita tener que
                             recordar dónde queda el límite. -->
                        <TextBlock Text="Chamber pressure" Margin="0,0,0,4" />
                        <platinum:PlatinumLevelGauge x:Name="Presion" Value="78"
                                                     Orientation="Horizontal"
                                                     BandMode="Zones"
                                                     TrackThickness="18"
                                                     ShowScale="False"
                                                     Margin="0,0,0,10" />

                        <TextBlock Text="Lamp hours" Margin="0,0,0,4" />
                        <ProgressBar Value="34" Height="16" IsEnabled="False" Margin="0,0,0,10" />

                        <TextBlock Text="Next service" Margin="0,0,0,4" />
                        <platinum:PlatinumDateTimeField Mode="Date" Value="2026-11-12T09:30:00"
                                                        HorizontalAlignment="Left"
                                                        ToolTip="Click a part and use the arrows, or type." />
                    </StackPanel>
                </GroupBox>

                <!-- Los mandos van antes que los plegables en el orden del DockPanel:
                     así reservan su alto y lo que se aprieta al faltar espacio es el
                     panel plegable, que para eso se pliega. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button Content="Calibrate..." Margin="0,0,0,8" Click="OnCalibrate"
                            ToolTip="Runs the standard against the reference lines." />
                    <Button Content="Export Results..." Margin="0,0,0,8" Click="OnExport" />
                    <Button Content="Instrument..." Click="OnInstrument"
                            ToolTip="Connection and credentials for the bench controller." />
                </StackPanel>

            </DockPanel>

            <!-- Pie: la tecla por omisión, con su anillo -->
            <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                <Image DockPanel.Dock="Left" Source="{StaticResource IconMagnifier}"
                       Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Text="7 lines matched the reference table." />
                <Button DockPanel.Dock="Right" Content="Acquire" Width="104" IsDefault="True"
                        Click="OnAcquire"
                        ToolTip="Starts the run with the settings on this window." />
                <Button DockPanel.Dock="Right" Content="Stop" Width="90" Margin="0,0,12,0"
                        IsEnabled="False" />
                <TextBlock />
            </DockPanel>
        </Grid>
    </DockPanel>
</platinum:PlatinumWindow>
