<platinum:PlatinumWindow x:Class="MacOS9.Platinum.Gallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:platinum="clr-namespace:MacOS9.Platinum.Controls;assembly=MacOS9.Platinum"
        Title="Platinum Gallery"
        Width="560" Height="660">

    <!-- Cada control nuevo se agrega aquí como una fila de estados, para comparar    -->
    <!-- contra las capturas de referencia sin tener que armar una app completa.      -->
    <!-- El margen inferior deja libre el grow box, que se dibuja encima del         -->
    <!-- contenido: sin él, la flecha de bajar de la barra queda tapada.             -->
    <!-- El margen derecho negativo hace que el filo de la barra coincida con el     -->
    <!-- del marco en vez de sumarse a él, que es lo que lo hacía verse doble.       -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-1,16">
    <StackPanel Margin="20,16">

        <TabControl Margin="0,0,0,22" Height="150">
            <TabItem Header="Alerts">
                <StackPanel>
                    <CheckBox Content="Play alert sounds" IsChecked="True" Margin="0,0,0,8" />
                    <CheckBox Content="Play startup sound" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Output">
                <RadioButton Content="Built-in speaker" IsChecked="True" />
            </TabItem>
            <TabItem Header="Input">
                <TextBlock Text="Sin dispositivos de entrada."
                           FontFamily="{StaticResource ViewFontFamily}"
                           FontSize="{StaticResource ViewFontSize}" />
            </TabItem>
        </TabControl>

        <TextBlock Text="Push Button"
                   FontFamily="{StaticResource SystemFontFamily}"
                   FontSize="{StaticResource SystemFontSize}"
                   Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal">
            <!-- El anillo del botón por omisión se sale del rectángulo del botón,   -->
            <!-- así que hay que separarlo más de sus vecinos.                       -->
            <Button Content="Normal" Margin="0,0,20,0" />
            <Button Content="OK" IsDefault="True" Margin="0,0,20,0" />
            <Button Content="Disabled" IsEnabled="False" Margin="0,0,20,0" />
            <Button Content="Options..." />
        </StackPanel>

        <TextBlock Text="CheckBox y RadioButton"
                   FontFamily="{StaticResource SystemFontFamily}"
                   FontSize="{StaticResource SystemFontSize}"
                   Margin="0,22,0,10" />

        <StackPanel Orientation="Horizontal">
            <StackPanel Margin="0,0,32,0">
                <CheckBox Content="Play alert sounds" IsChecked="True" Margin="0,0,0,7" />
                <CheckBox Content="Play startup sound" Margin="0,0,0,7" />
                <CheckBox Content="Mixed" IsThreeState="True" IsChecked="{x:Null}" Margin="0,0,0,7" />
                <CheckBox Content="Disabled" IsEnabled="False" />
            </StackPanel>

            <StackPanel>
                <RadioButton Content="Manually" IsChecked="True" Margin="0,0,0,7" />
                <RadioButton Content="Using DHCP Server" Margin="0,0,0,7" />
                <RadioButton Content="Disabled" IsEnabled="False" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="Text Field"
                   FontFamily="{StaticResource SystemFontFamily}"
                   FontSize="{StaticResource SystemFontSize}"
                   Margin="0,22,0,10" />

        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="SampleField" Text="192.168.0.45" Width="140" Margin="0,0,12,0" />
            <TextBox Text="Solo lectura" Width="140" IsReadOnly="True" Margin="0,0,12,0" />
            <TextBox Text="Deshabilitado" Width="140" IsEnabled="False" />
        </StackPanel>

        <TextBlock Text="Popup Menu"
                   FontFamily="{StaticResource SystemFontFamily}"
                   FontSize="{StaticResource SystemFontSize}"
                   Margin="0,22,0,10" />

        <StackPanel Orientation="Horizontal">
            <ComboBox Width="150" SelectedIndex="0" Margin="0,0,14,0">
                <ComboBoxItem Content="Breeze" />
                <ComboBoxItem Content="Chime" />
                <ComboBoxItem Content="Droplet" />
                <ComboBoxItem Content="Indigo" />
                <ComboBoxItem Content="Quack" />
                <ComboBoxItem Content="Sosumi" />
            </ComboBox>

            <ComboBox Width="150" SelectedIndex="0" IsEnabled="False">
                <ComboBoxItem Content="Deshabilitado" />
            </ComboBox>
        </StackPanel>

        <TextBlock Text="Lista con columnas"
                   FontFamily="{StaticResource SystemFontFamily}"
                   FontSize="{StaticResource SystemFontSize}"
                   Margin="0,22,0,10" />

        <ListView Height="130" SelectedIndex="2" ItemsSource="{Binding Messages}">
            <ListView.View>
                <GridView>
                    <!-- Sobre dibujado a escala del tema, sin archivos externos. -->
                    <GridViewColumn Header="" Width="26">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Width="13" Height="10" HorizontalAlignment="Center">
                                    <Border BorderThickness="1"
                                            BorderBrush="{StaticResource TextBrush}"
                                            Background="{StaticResource ContentFaceBrush}" />
                                    <Path Data="M 0,0 L 6.5,5 L 13,0"
                                          Stroke="{StaticResource TextBrush}"
                                          StrokeThickness="1" />
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="From" Width="130" DisplayMemberBinding="{Binding Sender}" />
                    <GridViewColumn Header="Subject" Width="200" DisplayMemberBinding="{Binding Subject}" />
                    <GridViewColumn Header="Size" Width="60" DisplayMemberBinding="{Binding Size}" />
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Text="ScrollBar"
                   FontFamily="{StaticResource SystemFontFamily}"
                   FontSize="{StaticResource SystemFontSize}"
                   Margin="0,22,0,10" />

        <StackPanel Orientation="Horizontal">
            <!-- ViewportSize es lo que define el largo del thumb: sin él queda del  -->
            <!-- mínimo y no se alcanza a ver la textura.                             -->
            <ScrollBar Orientation="Vertical" Height="130" Minimum="0" Maximum="100"
                       ViewportSize="40" Value="30" Margin="0,0,24,0" />

            <StackPanel VerticalAlignment="Top">
                <ScrollBar Orientation="Horizontal" Width="300" Minimum="0" Maximum="100"
                           ViewportSize="40" Value="30" Margin="0,0,0,14" />
                <!-- Al tope del recorrido: sirve para comprobar que el thumb se pega -->
                <!-- a la flecha y no deja riel sobrante.                              -->
                <ScrollBar Orientation="Horizontal" Width="300" Minimum="0" Maximum="100"
                           ViewportSize="40" Value="100" Margin="0,0,0,14" />
                <ScrollBar Orientation="Horizontal" Width="300" Minimum="0" Maximum="100"
                           ViewportSize="40" Value="30" IsEnabled="False" />
            </StackPanel>
        </StackPanel>

    </StackPanel>
    </ScrollViewer>
</platinum:PlatinumWindow>
