<platinum:PlatinumWindow x:Class="MacOS9.Platinum.Gallery.InstrumentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:platinum="clr-namespace:MacOS9.Platinum.Controls;assembly=MacOS9.Platinum"
        Title="Bench Controller"
        Width="424" SizeToContent="Height"
        ResizeMode="NoResize" ShowGrowBox="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Host:" HorizontalAlignment="Right"
                   VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="bench-3.lab.local" Margin="0,0,0,9" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Operator:" HorizontalAlignment="Right"
                   VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="r.okonkwo" Margin="0,0,0,9" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Passphrase:" HorizontalAlignment="Right"
                   VerticalAlignment="Center" Margin="0,0,10,0" />
        <PasswordBox Grid.Row="2" Grid.Column="1" Password="spectra" Margin="0,0,0,9" />

        <Image Grid.Row="3" Grid.Column="0" Source="{StaticResource IconComputer}"
               Width="32" Height="32" HorizontalAlignment="Right"
               VerticalAlignment="Top" Margin="0,4,10,0" />
        <TextBlock Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="The controller keeps the vacuum pump running while the session is open." />

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Disconnect" Width="106" Margin="0,0,12,0" Click="OnClose" />
            <Button Content="Cancel" Width="90" Margin="0,0,12,0" Click="OnClose" />
            <Button Content="Connect" Width="90" IsDefault="True" Click="OnClose" />
        </StackPanel>
    </Grid>
</platinum:PlatinumWindow>
