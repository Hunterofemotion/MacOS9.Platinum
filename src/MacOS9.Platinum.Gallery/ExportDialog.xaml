<platinum:PlatinumWindow x:Class="MacOS9.Platinum.Gallery.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:platinum="clr-namespace:MacOS9.Platinum.Controls;assembly=MacOS9.Platinum"
        Title="Export Results"
        Width="452" SizeToContent="Height"
        ResizeMode="NoResize" ShowGrowBox="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Image Grid.Row="0" Grid.Column="0" Source="{StaticResource IconDocument}"
               Width="32" Height="32" VerticalAlignment="Top"
               HorizontalAlignment="Right" Margin="0,2,12,0" />

        <StackPanel Grid.Row="0" Grid.Column="1">
            <TextBlock Text="File name" Margin="0,0,0,4" />
            <TextBox Text="run-0412-B" Margin="0,0,0,10" />

            <TextBlock Text="Format" Margin="0,0,0,4" />
            <ComboBox SelectedIndex="0" Margin="0,0,0,10">
                <ComboBoxItem Content="Comma separated values" />
                <ComboBoxItem Content="Tab delimited text" />
                <ComboBoxItem Content="JCAMP-DX spectrum" />
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1">
            <CheckBox Content="Include baseline points" IsChecked="True" Margin="0,0,0,4" />
            <CheckBox Content="Include instrument metadata" IsChecked="True" Margin="0,0,0,4" />
            <CheckBox Content="Open when finished" />
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,12,0" Click="OnClose" />
            <Button Content="Export" Width="90" IsDefault="True" Click="OnClose" />
        </StackPanel>
    </Grid>
</platinum:PlatinumWindow>
