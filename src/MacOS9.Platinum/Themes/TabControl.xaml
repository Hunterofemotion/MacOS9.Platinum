<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MacOS9.Platinum.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Palette.xaml" />
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Pestaña. La seleccionada sube un par de píxeles, aclara su cara y se funde   -->
    <!-- con el panel; las demás quedan más abajo y más oscuras, como si estuvieran   -->
    <!-- detrás.                                                                      -->
    <Style x:Key="PlatinumTabItem" TargetType="{x:Type TabItem}">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontWeight" Value="{StaticResource SystemFontWeight}" />
        <Setter Property="FontSize" Value="{StaticResource SystemFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="14,2" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <!-- Sin solape: pegadas, los lados inclinados de dos vecinas     -->
                    <!-- forman la V. Con margen negativo una tapaba el filo de la    -->
                    <!-- otra y dejaba su borde inferior incompleto.                  -->
                    <Grid x:Name="Root" Margin="0,2,0,0">
                        <controls:TabShape x:Name="Shape"
                                           Fill="{StaticResource TabInactiveFaceBrush}"
                                           Stroke="{StaticResource TextBrush}"
                                           HighlightBrush="{StaticResource BevelHighlightBrush}"
                                           ShadowBrush="{StaticResource BevelDeepShadowBrush}"
                                           Slant="7"
                                           CornerRadius="5" />

                        <ContentPresenter x:Name="Header"
                                          ContentSource="Header"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- La activa sube solo dos píxeles: la diferencia de altura  -->
                        <!-- es sutil, lo que de verdad la distingue es la cara plana  -->
                        <!-- del mismo tono que el panel y el texto en negrita.        -->
                        <Trigger Property="IsSelected" Value="True">
                            <!-- La base se prolonga dos píxeles dentro del panel para  -->
                            <!-- tapar su filo y su escalón, y así las dos superficies  -->
                            <!-- se leen continuas.                                     -->
                            <Setter TargetName="Root" Property="Margin" Value="0,0,0,0" />
                            <Setter TargetName="Shape" Property="BaseExtension" Value="2" />
                            <Setter TargetName="Root" Property="Panel.ZIndex" Value="1" />
                            <Setter TargetName="Shape" Property="Fill" Value="{StaticResource PanelFaceBrush}" />
                            <Setter TargetName="Shape" Property="ShadowBrush" Value="{x:Null}" />
                            <!-- La negrita va dirigida al presentador del rótulo:      -->
                            <!-- puesta en el control se heredaría a TODO el contenido  -->
                            <!-- del tab, que saldría en bold sin pedirlo.              -->
                            <Setter TargetName="Header" Property="TextElement.FontWeight" Value="Bold" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shape" Property="Stroke" Value="{StaticResource BevelShadowBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlatinumTabControl" TargetType="{x:Type TabControl}">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontWeight" Value="{StaticResource SystemFontWeight}" />
        <Setter Property="FontSize" Value="{StaticResource SystemFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource PlatinumTabItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- La fila de pestañas se dibuja encima del panel para que   -->
                        <!-- la seleccionada tape el filo superior y se lea continua   -->
                        <!-- con él.                                                   -->
                        <TabPanel Grid.Row="0"
                                  Panel.ZIndex="1"
                                  Margin="10,0,0,0"
                                  IsItemsHost="True"
                                  KeyboardNavigation.TabIndex="1" />

                        <Border Grid.Row="1"
                                BorderThickness="1"
                                BorderBrush="{StaticResource TextBrush}"
                                Background="{StaticResource PanelFaceBrush}">
                            <Grid>
                                <!-- El nombre importa: TabControl busca esta pieza
                                     para saber dónde vive el contenido de la pestaña
                                     elegida, y de ahí salen el recorrido con el
                                     teclado hacia adentro del panel y el enfoque al
                                     cambiar de pestaña. -->
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}" />

                                <!-- Bisel levantado: luz arriba-izquierda y sombra     -->
                                <!-- abajo-derecha. Al revés que el marco de la ventana, -->
                                <!-- porque el panel va encima de ella, no metido.       -->
                                <Border BorderThickness="1,1,0,0"
                                        BorderBrush="{StaticResource BevelHighlightBrush}"
                                        IsHitTestVisible="False" />
                                <Border BorderThickness="0,0,1,1"
                                        BorderBrush="{StaticResource BevelShadowBrush}"
                                        IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource PlatinumTabControl}" />
    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource PlatinumTabItem}" />

</ResourceDictionary>
