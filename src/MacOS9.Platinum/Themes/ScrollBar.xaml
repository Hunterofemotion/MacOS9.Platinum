<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MacOS9.Platinum.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Palette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Textura del canal: tramado de dos grises en tablero de 2 px. Platinum no usa -->
    <!-- un gris liso ahí, y ese punteado es lo que distingue el canal de la cara de  -->
    <!-- los controles.                                                               -->
    <DrawingBrush x:Key="ScrollTrackTextureBrush"
                  TileMode="Tile"
                  Viewport="0,0,2,2"
                  ViewportUnits="Absolute"
                  Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFB4B4B4">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,2,2" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFC9C9C9">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,1,1" />
                            <RectangleGeometry Rect="1,1,1,1" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Botón de flecha. Comparte el cuerpo levantado del resto del tema, pero sin  -->
    <!-- esquinas redondeadas ni sombra: va embutido dentro del marco de la barra.    -->
    <Style x:Key="PlatinumScrollArrow" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Grid>
                        <Border x:Name="Face" Background="{StaticResource ControlFaceBrush}" />
                        <Border x:Name="BevelLight"
                                BorderThickness="1,1,0,0"
                                BorderBrush="{StaticResource BevelHighlightBrush}" />
                        <Border x:Name="BevelDark"
                                BorderThickness="0,0,1,1"
                                BorderBrush="{StaticResource BevelShadowBrush}" />
                        <ContentPresenter x:Name="Glyph"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ControlFacePressedBrush}" />
                            <Setter TargetName="BevelLight" Property="BorderBrush" Value="{StaticResource BevelDeepShadowBrush}" />
                            <Setter TargetName="BevelDark" Property="BorderBrush" Value="{x:Null}" />
                        </Trigger>
                        <!-- Sin bisel y con la flecha desvanecida: la barra sigue    -->
                        <!-- ocupando su lugar pero se lee como inactiva.              -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BevelLight" Property="BorderBrush" Value="{x:Null}" />
                            <Setter TargetName="BevelDark" Property="BorderBrush" Value="{x:Null}" />
                            <Setter TargetName="Glyph" Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Zona de página: transparente, deja ver el canal. -->
    <Style x:Key="PlatinumScrollPage" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Asidero del thumb: cuatro rayitas centradas. Corren perpendiculares al      -->
    <!-- recorrido, así que la barra vertical las lleva horizontales y viceversa;     -->
    <!-- por eso hay dos estilos y no uno solo.                                       -->
    <Style x:Key="PlatinumScrollThumbVertical" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid x:Name="Root">
                        <!-- Sin filos laterales: los costados los cierra el propio -->
                        <!-- marco de la barra, no el thumb.                        -->
                        <Border x:Name="ThumbFace"
                                BorderThickness="0,1,0,1"
                                BorderBrush="{StaticResource TextBrush}"
                                Background="{StaticResource ScrollThumbBrush}" />

                        <StackPanel x:Name="Grip"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Rectangle Width="9" Height="1" Margin="0,0,0,2" Fill="{StaticResource ScrollThumbGripBrush}" />
                            <Rectangle Width="9" Height="1" Margin="0,0,0,2" Fill="{StaticResource ScrollThumbGripBrush}" />
                            <Rectangle Width="9" Height="1" Margin="0,0,0,2" Fill="{StaticResource ScrollThumbGripBrush}" />
                            <Rectangle Width="9" Height="1" Fill="{StaticResource ScrollThumbGripBrush}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Al arrastrarlo se oscurece: es la única realimentación que -->
                        <!-- da Platinum durante el arrastre, porque el thumb no se     -->
                        <!-- hunde como un botón.                                        -->
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbFace" Property="Background" Value="{StaticResource ScrollThumbPressedBrush}" />
                        </Trigger>

                        <!-- Con la barra deshabilitada el canal queda vacío. Va aquí y -->
                        <!-- no en el template de la barra porque ocultar el Track desde -->
                        <!-- allá no surte efecto; IsEnabled sí se propaga hasta el      -->
                        <!-- thumb.                                                      -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlatinumScrollThumbHorizontal" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid x:Name="Root">
                        <Border x:Name="ThumbFace"
                                BorderThickness="1,0,1,0"
                                BorderBrush="{StaticResource TextBrush}"
                                Background="{StaticResource ScrollThumbBrush}" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Rectangle Width="1" Height="9" Margin="0,0,2,0" Fill="{StaticResource ScrollThumbGripBrush}" />
                            <Rectangle Width="1" Height="9" Margin="0,0,2,0" Fill="{StaticResource ScrollThumbGripBrush}" />
                            <Rectangle Width="1" Height="9" Margin="0,0,2,0" Fill="{StaticResource ScrollThumbGripBrush}" />
                            <Rectangle Width="1" Height="9" Fill="{StaticResource ScrollThumbGripBrush}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbFace" Property="Background" Value="{StaticResource ScrollThumbPressedBrush}" />
                        </Trigger>

                        <!-- Con la barra deshabilitada el canal queda vacío. Va aquí y -->
                        <!-- no en el template de la barra porque ocultar el Track desde -->
                        <!-- allá no surte efecto; IsEnabled sí se propaga hasta el      -->
                        <!-- thumb.                                                      -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlatinumScrollBar" TargetType="{x:Type ScrollBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Border BorderThickness="1"
                            BorderBrush="{StaticResource TextBrush}"
                            Background="{StaticResource ScrollTrackBrush}">
                        <Grid>
                            <!-- Las dos flechas van juntas al final, no una en cada    -->
                            <!-- extremo. Es la disposición de Platinum con Smart        -->
                            <!-- Scrolling, la que trae el modelo de referencia.         -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="14" />
                            </Grid.RowDefinitions>

                            <!-- Canal con textura: un tramado fino, no un gris liso.   -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource ScrollTrackTextureBrush}"
                                    RenderOptions.EdgeMode="Aliased"
                                    IsHitTestVisible="False" />

                            <Border Grid.Row="0"
                                    BorderThickness="1,1,0,0"
                                    BorderBrush="{StaticResource FrameShadowBrush}"
                                    IsHitTestVisible="False" />

                            <!-- Segundo paso de sombra, más claro. La profundidad se  -->
                            <!-- construye con dos tonos de gris, sin recurrir a luz.  -->
                            <Border Grid.Row="0"
                                    Margin="1,1,0,0"
                                    BorderThickness="1,1,0,0"
                                    BorderBrush="{StaticResource BevelShadowBrush}"
                                    IsHitTestVisible="False" />

                            <RepeatButton Grid.Row="1"
                                          Style="{StaticResource PlatinumScrollArrow}"
                                          Command="ScrollBar.LineUpCommand">
                                <controls:ArrowGlyph Direction="Up" Fill="{StaticResource TextBrush}" />
                            </RepeatButton>

                            <Track x:Name="PART_Track"
                                   Grid.Row="0"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource PlatinumScrollPage}"
                                                  Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PlatinumScrollThumbVertical}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource PlatinumScrollPage}"
                                                  Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>

                            <RepeatButton Grid.Row="2"
                                          Style="{StaticResource PlatinumScrollArrow}"
                                          Command="ScrollBar.LineDownCommand">
                                <controls:ArrowGlyph Direction="Down" Fill="{StaticResource TextBrush}" />
                            </RepeatButton>

                            <!-- Filo entre las dos flechas y entre el par y el canal. -->
                            <Border Grid.Row="1" Height="1" VerticalAlignment="Top"
                                    Background="{StaticResource TextBrush}" IsHitTestVisible="False" />
                            <Border Grid.Row="2" Height="1" VerticalAlignment="Top"
                                    Background="{StaticResource TextBrush}" IsHitTestVisible="False" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Deshabilitada, Platinum deja el canal vacío: sin thumb no -->
                        <!-- hay nada que arrastrar y eso mismo lo comunica.            -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Track" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Border BorderThickness="1"
                                    BorderBrush="{StaticResource TextBrush}"
                                    Background="{StaticResource ScrollTrackBrush}">
                                <Grid>
                                    <!-- Las dos flechas juntas al final, como en el     -->
                                    <!-- modelo de Platinum con Smart Scrolling.         -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="14" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="{StaticResource ScrollTrackTextureBrush}"
                                            RenderOptions.EdgeMode="Aliased"
                                            IsHitTestVisible="False" />

                                    <Border Grid.Column="0"
                                            BorderThickness="1,1,0,0"
                                            BorderBrush="{StaticResource FrameShadowBrush}"
                                            IsHitTestVisible="False" />

                                    <Border Grid.Column="0"
                                            Margin="1,1,0,0"
                                            BorderThickness="1,1,0,0"
                                            BorderBrush="{StaticResource BevelShadowBrush}"
                                            IsHitTestVisible="False" />

                                    <RepeatButton Grid.Column="1"
                                                  Style="{StaticResource PlatinumScrollArrow}"
                                                  Command="ScrollBar.LineLeftCommand">
                                        <controls:ArrowGlyph Direction="Left" Fill="{StaticResource TextBrush}" />
                                    </RepeatButton>

                                    <Track x:Name="PART_Track" Grid.Column="0">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource PlatinumScrollPage}"
                                                          Command="ScrollBar.PageLeftCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource PlatinumScrollThumbHorizontal}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource PlatinumScrollPage}"
                                                          Command="ScrollBar.PageRightCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>

                                    <RepeatButton Grid.Column="2"
                                                  Style="{StaticResource PlatinumScrollArrow}"
                                                  Command="ScrollBar.LineRightCommand">
                                        <controls:ArrowGlyph Direction="Right" Fill="{StaticResource TextBrush}" />
                                    </RepeatButton>

                                    <!-- Filo entre las flechas y entre el par y el canal. -->
                                    <Border Grid.Column="1" Width="1" HorizontalAlignment="Left"
                                            Background="{StaticResource TextBrush}" IsHitTestVisible="False" />
                                    <Border Grid.Column="2" Width="1" HorizontalAlignment="Left"
                                            Background="{StaticResource TextBrush}" IsHitTestVisible="False" />
                                </Grid>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="PART_Track" Property="Visibility" Value="Hidden" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource PlatinumScrollBar}" />

</ResourceDictionary>
