<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MacOS9.Platinum.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Palette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Botón de flecha. Cara plana, sin bisel: va embutido dentro del marco de la  -->
    <!-- barra y el relieve solo ensuciaba el filo que ya cierra ese marco.           -->
    <Style x:Key="PlatinumScrollArrow" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Grid>
                        <Border x:Name="Face" Background="{StaticResource ControlFaceBrush}" />
                        <ContentPresenter x:Name="Glyph"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Al presionar solo oscurece la cara: sin bisel, ese cambio -->
                        <!-- de tono es toda la realimentación que queda.              -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ControlFacePressedBrush}" />
                        </Trigger>
                        <!-- Con la flecha desvanecida la barra sigue ocupando su      -->
                        <!-- lugar pero se lee como inactiva.                          -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Glyph" Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Zona de página: transparente, deja ver el canal. -->
    <Style x:Key="PlatinumScrollPage" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Asidero del thumb: cuatro rayitas centradas. Corren perpendiculares al      -->
    <!-- recorrido, así que la barra vertical las lleva horizontales y viceversa;     -->
    <!-- por eso hay dos estilos y no uno solo.                                       -->
    <Style x:Key="PlatinumScrollThumbVertical" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid x:Name="Root">
                        <!-- Sin filos de ningún lado: los costados los cierra el      -->
                        <!-- marco de la barra, y por donde corre no lleva nada, así   -->
                        <!-- que se lee como una pieza que se desliza y no como una    -->
                        <!-- caja pintada sobre el canal.                              -->
                        <Border x:Name="ThumbFace"
                                Background="{StaticResource ScrollThumbBrush}" />

                        <StackPanel x:Name="Grip"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Rectangle Width="9" Height="1" Margin="0,0,0,2" Fill="{StaticResource ScrollThumbGripBrush}" />
                            <Rectangle Width="9" Height="1" Margin="0,0,0,2" Fill="{StaticResource ScrollThumbGripBrush}" />
                            <Rectangle Width="9" Height="1" Margin="0,0,0,2" Fill="{StaticResource ScrollThumbGripBrush}" />
                            <Rectangle Width="9" Height="1" Fill="{StaticResource ScrollThumbGripBrush}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Al arrastrarlo se oscurece: es la única realimentación que -->
                        <!-- da Platinum durante el arrastre, porque el thumb no se     -->
                        <!-- hunde como un botón.                                        -->
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbFace" Property="Background" Value="{StaticResource ScrollThumbPressedBrush}" />
                        </Trigger>

                        <!-- Con la barra deshabilitada el canal queda vacío. Va aquí y -->
                        <!-- no en el template de la barra porque ocultar el Track desde -->
                        <!-- allá no surte efecto; IsEnabled sí se propaga hasta el      -->
                        <!-- thumb.                                                      -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlatinumScrollThumbHorizontal" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid x:Name="Root">
                        <Border x:Name="ThumbFace"
                                Background="{StaticResource ScrollThumbBrush}" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Rectangle Width="1" Height="9" Margin="0,0,2,0" Fill="{StaticResource ScrollThumbGripBrush}" />
                            <Rectangle Width="1" Height="9" Margin="0,0,2,0" Fill="{StaticResource ScrollThumbGripBrush}" />
                            <Rectangle Width="1" Height="9" Margin="0,0,2,0" Fill="{StaticResource ScrollThumbGripBrush}" />
                            <Rectangle Width="1" Height="9" Fill="{StaticResource ScrollThumbGripBrush}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbFace" Property="Background" Value="{StaticResource ScrollThumbPressedBrush}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlatinumScrollBar" TargetType="{x:Type ScrollBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Width" Value="16" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <!-- El contorno negro va como capa superior, no como Border       -->
                    <!-- contenedor: con redondeo fraccional los hijos alcanzaban a    -->
                    <!-- sobrepintar la fila del borde en el extremo de las flechas y  -->
                    <!-- la barra quedaba abierta. Dibujado encima, siempre cierra.    -->
                    <Grid>
                        <Border x:Name="Face" Background="{StaticResource ScrollTrackBrush}" />

                        <!-- Sin margen: con él se asomaba la cara por la orilla y se  -->
                        <!-- leía como un filo gris alrededor de la barra y de las     -->
                        <!-- flechas.                                                   -->
                        <Grid>
                            <!-- Las dos flechas van juntas al final, no una en cada    -->
                            <!-- extremo. Es la disposición de Platinum con Smart        -->
                            <!-- Scrolling, la que trae el modelo de referencia.         -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="14" />
                            </Grid.RowDefinitions>

                            <!-- Canal con textura rasterizada a píxel físico: el       -->
                            <!-- mosaico de 2 unidades lógicas se interpolaba en moiré  -->
                            <!-- a escalas fraccionarias.                               -->
                            <controls:CheckerTexture x:Name="Texture"
                                                     Grid.Row="0"
                                                     LightBrush="{StaticResource ScrollTrackLightBrush}"
                                                     DarkBrush="{StaticResource ScrollTrackDarkBrush}" />

                            <RepeatButton Grid.Row="1"
                                          Style="{StaticResource PlatinumScrollArrow}"
                                          Command="ScrollBar.LineUpCommand">
                                <controls:ArrowGlyph Direction="Up" Fill="{StaticResource TextBrush}" />
                            </RepeatButton>

                            <!-- Recortado a su celda: con la ventana muy baja el
                                 canal se queda más corto que el cursor, y sin esto
                                 el cursor se dibuja encima de las flechas. -->
                            <Track x:Name="PART_Track"
                                   Grid.Row="0"
                                   ClipToBounds="True"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource PlatinumScrollPage}"
                                                  Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PlatinumScrollThumbVertical}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource PlatinumScrollPage}"
                                                  Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>

                            <RepeatButton Grid.Row="2"
                                          Style="{StaticResource PlatinumScrollArrow}"
                                          Command="ScrollBar.LineDownCommand">
                                <controls:ArrowGlyph Direction="Down" Fill="{StaticResource TextBrush}" />
                            </RepeatButton>

                            <!-- Filo entre las dos flechas y entre el par y el canal. -->
                            <Border x:Name="Sep1" Grid.Row="1" Height="1" VerticalAlignment="Top"
                                    Background="{StaticResource TextBrush}" IsHitTestVisible="False" />
                            <Border x:Name="Sep2" Grid.Row="2" Height="1" VerticalAlignment="Top"
                                    Background="{StaticResource TextBrush}" IsHitTestVisible="False" />
                        </Grid>

                        <!-- El grosor sale de la propiedad del control, no fijo, para -->
                        <!-- que quien la aloje pueda apagar los lados que ya cierra   -->
                        <!-- su propio marco. Dos filos negros encimados se leen como  -->
                        <!-- una raya del doble de grueso.                             -->
                        <Border x:Name="Edge"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{StaticResource TextBrush}"
                                IsHitTestVisible="False" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Deshabilitada, todo el control baja de intensidad, como en -->
                        <!-- el resto del tema: marco y filos a gris, canal plano sin   -->
                        <!-- textura ni sombras, y sin thumb.                           -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Track" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="Edge" Property="BorderBrush" Value="{StaticResource BevelShadowBrush}" />
                            <Setter TargetName="Sep1" Property="Background" Value="{StaticResource BevelShadowBrush}" />
                            <Setter TargetName="Sep2" Property="Background" Value="{StaticResource BevelShadowBrush}" />
                            <Setter TargetName="Texture" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ControlFaceDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid>
                                <Border x:Name="Face" Background="{StaticResource ScrollTrackBrush}" />

                                <Grid>
                                    <!-- Las dos flechas juntas al final, como en el     -->
                                    <!-- modelo de Platinum con Smart Scrolling.         -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="14" />
                                    </Grid.ColumnDefinitions>

                                    <controls:CheckerTexture x:Name="Texture"
                                                             Grid.Column="0"
                                                             LightBrush="{StaticResource ScrollTrackLightBrush}"
                                                             DarkBrush="{StaticResource ScrollTrackDarkBrush}" />

                                    <RepeatButton Grid.Column="1"
                                                  Style="{StaticResource PlatinumScrollArrow}"
                                                  Command="ScrollBar.LineLeftCommand">
                                        <controls:ArrowGlyph Direction="Left" Fill="{StaticResource TextBrush}" />
                                    </RepeatButton>

                                    <Track x:Name="PART_Track" Grid.Column="0">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource PlatinumScrollPage}"
                                                          Command="ScrollBar.PageLeftCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource PlatinumScrollThumbHorizontal}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource PlatinumScrollPage}"
                                                          Command="ScrollBar.PageRightCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>

                                    <RepeatButton Grid.Column="2"
                                                  Style="{StaticResource PlatinumScrollArrow}"
                                                  Command="ScrollBar.LineRightCommand">
                                        <controls:ArrowGlyph Direction="Right" Fill="{StaticResource TextBrush}" />
                                    </RepeatButton>

                                    <!-- Filo entre las flechas y entre el par y el canal. -->
                                    <Border x:Name="Sep1" Grid.Column="1" Width="1" HorizontalAlignment="Left"
                                            Background="{StaticResource TextBrush}" IsHitTestVisible="False" />
                                    <Border x:Name="Sep2" Grid.Column="2" Width="1" HorizontalAlignment="Left"
                                            Background="{StaticResource TextBrush}" IsHitTestVisible="False" />
                                </Grid>

                                <Border x:Name="Edge"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        BorderBrush="{StaticResource TextBrush}"
                                        IsHitTestVisible="False" />
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="PART_Track" Property="Visibility" Value="Hidden" />
                                    <Setter TargetName="Edge" Property="BorderBrush" Value="{StaticResource BevelShadowBrush}" />
                                    <Setter TargetName="Sep1" Property="Background" Value="{StaticResource BevelShadowBrush}" />
                                    <Setter TargetName="Sep2" Property="Background" Value="{StaticResource BevelShadowBrush}" />
                                    <Setter TargetName="Texture" Property="Visibility" Value="Hidden" />
                                    <Setter TargetName="Face" Property="Background" Value="{StaticResource ControlFaceDisabledBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource PlatinumScrollBar}" />

</ResourceDictionary>
