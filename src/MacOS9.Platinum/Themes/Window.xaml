<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:controls="clr-namespace:MacOS9.Platinum.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Palette.xaml" />
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Rayado diagonal del grow box. El tile de 4 unidades cae en píxel entero a    -->
    <!-- las escalas comunes (5 px a 125 %, 6 a 150 %), así que no se interpola.      -->
    <DrawingBrush x:Key="GrowBoxHatchBrush"
                  TileMode="Tile"
                  Viewport="0,0,4,4"
                  ViewportUnits="Absolute"
                  Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="{StaticResource Gray2}" />
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,4,4" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M 0,4 L 4,0 L 4,1.5 L 1.5,4 Z">
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="{StaticResource Gray9}" />
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Cara de la barra de título. Termina en el mismo gris del canal para que la   -->
    <!-- barra y los marcos laterales se lean como una sola pieza; el respaldo del    -->
    <!-- título usa este mismo pincel para taparle las rayas sin costura.             -->
    <LinearGradientBrush x:Key="TitleBarFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="{StaticResource Gray0}" />
        <GradientStop Offset="0.4" Color="{StaticResource Gray2}" />
        <GradientStop Offset="1.0" Color="{StaticResource Gray2}" />
    </LinearGradientBrush>

    <!-- Cajas de la barra de título (close, zoom, collapse). Cuadrado de 11 px con  -->
    <!-- marco negro, realce blanco interior y cara gris.                             -->
    <Style x:Key="PlatinumTitleBarBox" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Frame"
                            BorderThickness="1"
                            BorderBrush="{StaticResource TextBrush}"
                            Background="{StaticResource BevelHighlightBrush}">
                        <Border x:Name="Face"
                                Margin="1"
                                Background="{StaticResource ControlFaceGradient}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BevelShadowBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ControlFacePressedGradient}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:PlatinumWindow}">
        <Setter Property="Background" Value="{StaticResource WindowFaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SystemFontSize}" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />

        <!-- Platinum se dibujó para una retícula de píxeles enteros. El modo Ideal    -->
        <!-- de WPF posiciona las astas en fracciones de píxel, así que a 11 px un     -->
        <!-- trazo de uno se reparte entre tres columnas y el texto se lee blando.     -->
        <!-- Display usa métricas compatibles y ajusta el glifo a la retícula, que es  -->
        <!-- lo que documenta Microsoft para texto chico. Ambas propiedades se heredan,-->
        <!-- también hacia los popups, que cuelgan de esta ventana en el árbol lógico. -->
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />

        <!-- WindowChrome mantiene el arrastre, el redimensionado y el acople de      -->
        <!-- Windows aunque el chrome nativo esté oculto. CaptionHeight es la franja   -->
        <!-- que el sistema trata como barra de título arrastrable.                    -->
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <!-- CaptionHeight debe coincidir con TitleBarHeight; si se queda      -->
                <!-- corta, la parte baja de la barra deja de arrastrar la ventana.    -->
                <!-- Sin vidrio: la sombra la dibuja el propio template, no DWM. -->
                <shell:WindowChrome CaptionHeight="24"
                                    ResizeBorderThickness="4"
                                    GlassFrameThickness="0"
                                    CornerRadius="0"
                                    UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PlatinumWindow}">
                    <Border x:Name="PART_Root"
                            BorderThickness="1"
                            BorderBrush="{StaticResource TextBrush}">
                        <!-- Realce blanco pegado al filo negro, solo arriba y a la    -->
                        <!-- izquierda: es lo que hace que la ventana se lea levantada -->
                        <!-- sobre el escritorio.                                      -->
                        <Border BorderThickness="1,1,0,0"
                                BorderBrush="{StaticResource BevelHighlightBrush}"
                                Background="{TemplateBinding Background}">
                        <Grid>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Barra de título. El rayado corre completo detrás y el   -->
                            <!-- título lo tapa con un respaldo del mismo degradado de   -->
                            <!-- la barra; al vivir en la columna estrella, un título    -->
                            <!-- largo se recorta con elipsis en vez de empujar las      -->
                            <!-- cajas de zoom y collapse fuera de la ventana.           -->
                            <Grid x:Name="TitleBar"
                                  Height="{TemplateBinding TitleBarHeight}"
                                  Background="{StaticResource TitleBarFaceBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- El margen coincide con el canal del marco para que -->
                                <!-- las cajas queden a plomo con el filo del contenido.-->
                                <Button x:Name="PART_CloseBox"
                                        Grid.Column="0"
                                        Margin="8,0,2,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PlatinumTitleBarBox}" />

                                <Grid Grid.Column="1">
                                    <!-- Solo las filas oscuras: las claras dejan ver el -->
                                    <!-- degradado de la barra, así el bloque de rayas   -->
                                    <!-- no se lee como un parche más claro.             -->
                                    <controls:Pinstripe x:Name="Stripes"
                                                        Margin="4,5"
                                                        LightBrush="{x:Null}"
                                                        DarkBrush="#FF8A8A8A" />

                                    <Border x:Name="TitleBack"
                                            HorizontalAlignment="Center"
                                            Background="{StaticResource TitleBarFaceBrush}"
                                            Padding="6,0">
                                        <TextBlock x:Name="TitleText"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{TemplateBinding FontFamily}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{TemplateBinding Title}" />
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            Margin="2,0,8,0"
                                            VerticalAlignment="Center">
                                    <Button x:Name="PART_ZoomBox"
                                            Margin="0,0,2,0"
                                            Style="{StaticResource PlatinumTitleBarBox}" />
                                    <Button x:Name="PART_CollapseBox"
                                            Style="{StaticResource PlatinumTitleBarBox}" />
                                </StackPanel>
                            </Grid>

                            <!-- Contenido. El canal gris de 3 px en laterales e inferior  -->
                            <!-- y el filo negro interior son parte del marco de la        -->
                            <!-- ventana, no del contenido: en Platinum el área útil       -->
                            <!-- siempre queda hundida respecto del marco.                 -->
                            <!-- El escalón de profundidad va por FUERA del filo, en el  -->
                            <!-- canal. Por dentro se metía entre el contenido y el      -->
                            <!-- marco, y la barra de desplazamiento dejaba de tocarlo.  -->
                            <Border x:Name="ContentArea"
                                    Grid.Row="1"
                                    Margin="7,0,7,7"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource FrameShadowBrush}">
                                <Border BorderThickness="1"
                                        BorderBrush="{StaticResource TextBrush}">
                                <Grid>
                                    <!-- El contenido llega a ras del filo. -->
                                    <ContentPresenter />

                                    <!-- Mismo lado que el ancho del scrollbar, para   -->
                                    <!-- que ambos cierren la esquina a plomo.         -->
                                    <Border x:Name="PART_GrowBox"
                                            Width="16"
                                            Height="16"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            BorderThickness="1,1,0,0"
                                            BorderBrush="{StaticResource TextBrush}"
                                            Background="{StaticResource GrowBoxHatchBrush}" />
                                </Grid>
                                </Border>
                            </Border>
                        </Grid>

                            <!-- Canto de la ventana: el gris se va oscureciendo hacia -->
                            <!-- el filo, como si el marco tuviera espesor y curvara    -->
                            <!-- hacia el borde. No es una sombra proyectada sobre el   -->
                            <!-- escritorio, se pinta sobre la propia ventana.          -->
                            <Border Height="2"
                                    VerticalAlignment="Bottom"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <!-- El arranque es Gray11 con alfa 0: el mismo -->
                                        <!-- tono del cierre, solo transparente.        -->
                                        <GradientStop Offset="0.0" Color="#00444444" />
                                        <GradientStop Offset="1.0" Color="{StaticResource Gray11}" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Border Width="2"
                                    HorizontalAlignment="Right"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <!-- El arranque es Gray11 con alfa 0: el mismo -->
                                        <!-- tono del cierre, solo transparente.        -->
                                        <GradientStop Offset="0.0" Color="#00444444" />
                                        <GradientStop Offset="1.0" Color="{StaticResource Gray11}" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        </Border>
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Ventana inactiva: sin rayas, sin cajas y título en gris. Es la  -->
                        <!-- señal de foco de Platinum, no hay cambio de color de fondo.     -->
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="Stripes" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                            <Setter TargetName="PART_CloseBox" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_ZoomBox" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_CollapseBox" Property="Visibility" Value="Hidden" />
                        </Trigger>

                        <Trigger Property="IsCollapsed" Value="True">
                            <Setter TargetName="ContentArea" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="ShowGrowBox" Value="False">
                            <Setter TargetName="PART_GrowBox" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
