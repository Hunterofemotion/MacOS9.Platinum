<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MacOS9.Platinum.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Palette.xaml" />
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Medidor de nivel. El estilo solo pone tintas y tipografía: el dibujo va en  -->
    <!-- el control, porque cada filo y cada marca se calculan sobre el píxel físico. -->
    <!--                                                                              -->
    <!-- El carril va sin sombra interior, a diferencia del campo de texto. En un      -->
    <!-- campo el rehundido invita a escribir dentro; en un medidor nadie escribe, y   -->
    <!-- los dos tonos le comían cuatro píxeles al área de color sin aportar nada.     -->
    <!-- Las propiedades siguen ahí para quien quiera el pozo completo.                -->
    <Style TargetType="{x:Type controls:PlatinumLevelGauge}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource ContentFaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource TextBrush}" />

        <!-- La caja de la cifra sí va rehundida: es un registro y se lee mejor    -->
        <!-- como campo. De un tono, no de dos: mide lo que el carril de alto y    -->
        <!-- dos se comerían la mitad.                                             -->
        <Setter Property="ReadoutShadowBrush" Value="{StaticResource BevelShadowBrush}" />
        <Setter Property="ReadoutHighlightBrush" Value="{StaticResource BevelHighlightBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource ViewFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SmallFontSize}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

</ResourceDictionary>
