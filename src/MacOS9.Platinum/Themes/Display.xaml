<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MacOS9.Platinum.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Palette.xaml" />
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Visor de tablero: pozo negro con dígitos de fósforo. El pozo es el mismo del  -->
    <!-- campo de texto, con las tintas cambiadas: sobre negro la sombra clara y el    -->
    <!-- realce oscuro se invierten, porque la luz sigue entrando de arriba pero la    -->
    <!-- superficie ya no es gris.                                                     -->
    <Style TargetType="{x:Type controls:PlatinumDisplay}">
        <Setter Property="Background" Value="{StaticResource DisplayFaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DisplayInkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource ViewFontSize}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PlatinumDisplay}">
                    <!-- Bisel exterior: la pantalla va embutida en la cara de la
                         ventana, no suelta encima. Sombra arriba y a la izquierda,
                         realce abajo y a la derecha, que es el rehundido de siempre
                         del tema. Sin él la pantalla negra flota como una calcomanía
                         pegada al panel. -->
                    <Border BorderThickness="1,1,0,0"
                            BorderBrush="{StaticResource FrameShadowBrush}">
                        <Border BorderThickness="0,0,1,1"
                                BorderBrush="{StaticResource BevelHighlightBrush}">
                            <Border Padding="2"
                                    Background="{StaticResource WindowFaceBrush}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <TextBlock Text="{TemplateBinding Text}"
                                       Margin="{TemplateBinding Padding}"
                                       TextAlignment="{TemplateBinding TextAlignment}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       VerticalAlignment="Center" />

                            <!-- El rehundido va encima del texto para que no se
                                 pierda cuando el número llega al filo. -->
                            <Border BorderThickness="0,0,1,1"
                                    BorderBrush="{StaticResource DisplayHighlightBrush}"
                                    IsHitTestVisible="False" />
                            <Border BorderThickness="1,1,0,0"
                                    BorderBrush="{StaticResource DisplayShadowBrush}"
                                    IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                            </Border>
                        </Border>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisplayInkDimBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Los signos de transporte heredan la tinta del texto y no traen tamaño fijo:  -->
    <!-- quien los aloja decide, igual que con las flechas del scrollbar.             -->
    <Style TargetType="{x:Type controls:TransportGlyph}">
        <Setter Property="Fill" Value="{StaticResource TextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
