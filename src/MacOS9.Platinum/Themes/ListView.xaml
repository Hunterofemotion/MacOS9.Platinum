<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Palette.xaml" />
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Encabezado de columna. Es el cuerpo levantado del tema, pero achatado: sin   -->
    <!-- esquinas redondeadas ni sombra, porque va embutido en una fila continua.     -->
    <Style x:Key="PlatinumColumnHeader" TargetType="{x:Type GridViewColumnHeader}">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <!-- Los nombres de columna van un punto por debajo del resto del chrome: son -->
        <!-- rótulos de estructura, no contenido.                                     -->
        <Setter Property="FontSize" Value="{StaticResource SmallFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Height" Value="18" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                    <Grid>
                        <Border x:Name="Face" Background="{StaticResource ControlFaceBrush}" />
                        <Border x:Name="BevelLight"
                                BorderThickness="0,1,0,0"
                                BorderBrush="{StaticResource BevelHighlightBrush}" />

                        <!-- Filo inferior y separador de columnas. La fila se cierra   -->
                        <!-- abajo con el gris medido en la referencia, no con negro:   -->
                        <!-- el negro chocaba con el filo de la barra de desplazamiento -->
                        <!-- y los dos juntos se leían como una raya gruesa.            -->
                        <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource HeaderRuleBrush}" />
                        <!-- El divisor va del lado izquierdo, no del derecho. Con el   -->
                        <!-- derecho quedaba una raya después de la última columna y el -->
                        <!-- tramo sobrante se leía como una columna sin nombre; con el -->
                        <!-- izquierdo, ese tramo continúa la última columna, como en   -->
                        <!-- el Finder. El primer encabezado esconde el suyo contra el  -->
                        <!-- filo de la caja.                                           -->
                        <Border x:Name="Separator"
                                BorderThickness="1,0,0,0"
                                BorderBrush="{StaticResource BevelShadowBrush}" />

                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ControlFacePressedBrush}" />
                            <Setter TargetName="BevelLight" Property="BorderBrush" Value="{x:Null}" />
                            <Setter Property="Foreground" Value="{StaticResource TextInvertedBrush}" />
                        </Trigger>

                        <!-- GridView agrega un encabezado de relleno al final para      -->
                        <!-- cubrir el ancho sobrante. Se oculta por completo: la franja -->
                        <!-- del mismo gris que va detrás ya cubre esa zona, así que no  -->
                        <!-- hace falta y solo se leía como una columna sin nombre.      -->
                        <Trigger Property="Role" Value="Padding">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Renglón. El resalte de Platinum es azul claro con el texto en negro, igual   -->
    <!-- que en el campo de texto y el popup menu.                                    -->
    <Style x:Key="PlatinumListViewItem" TargetType="{x:Type ListViewItem}">
        <Setter Property="FontFamily" Value="{StaticResource ViewFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource ViewFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0,2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />


        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">

                    <!-- Sangra dos unidades hacia abajo. El panel coloca los renglones cada
                         20.8 unidades pero cada uno se redondea a 20, así que entre uno
                         y otro quedan una o dos filas de píxeles que nadie pinta. No se
                         ven entre renglones blancos; bajo la banda de selección salían
                         como una raya clara pegada al divisor. La sangría solo llena esa
                         costura: el renglón de abajo se dibuja después y cubre lo que
                         sobre.                                                          -->
                    <Border x:Name="Row"
                            Background="Transparent"
                            Margin="0,-2,0,0">
                        <Grid>
                            <!-- El relleno envuelve solo al contenido. Cuando el       -->
                            <!-- divisor vivía dentro del relleno quedaba tres píxeles  -->
                            <!-- por encima del borde real del renglón, y esas tres     -->
                            <!-- filas —que son del renglón de arriba— se veían como    -->
                            <!-- una raya blanca justo debajo del divisor en cuanto el  -->
                            <!-- renglón de abajo estaba seleccionado.                  -->
                            <Border Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <!-- Sin GridView no hay ColumnCollection y el     -->
                                    <!-- presentador de fila no dibuja nada: la lista  -->
                                    <!-- salía vacía. El ContentPresenter es el camino -->
                                    <!-- para una lista simple.                        -->
                                    <GridViewRowPresenter x:Name="Columns"
                                                          Columns="{TemplateBinding GridView.ColumnCollection}"
                                                          Content="{TemplateBinding Content}" />
                                    <ContentPresenter x:Name="Plain"
                                                      Margin="4,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <Rectangle x:Name="Divider"
                                       Height="1"
                                       VerticalAlignment="Top"
                                       Fill="{StaticResource RowDividerBrush}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="GridView.ColumnCollection" Value="{x:Null}">
                            <Setter TargetName="Columns" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Plain" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- El divisor también se tiñe: si no, la banda de selección   -->
                        <!-- termina un píxel antes y queda una raya clara pegada al    -->
                        <!-- renglón siguiente.                                         -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectionBrush}" />
                            <Setter TargetName="Divider" Property="Fill" Value="{StaticResource SelectionBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="Selector.IsSelectionActive" Value="False" />
                            </MultiTrigger.Conditions>
                            <!-- Con la lista sin foco el resalte pasa a gris, como en -->
                            <!-- el campo de texto.                                     -->
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectionInactiveBrush}" />
                            <Setter TargetName="Divider" Property="Fill" Value="{StaticResource SelectionInactiveBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plantilla propia del ScrollViewer que GridView usa por dentro. En la de      -->
    <!-- serie, la barra vertical abarca también la fila de encabezados (el thumb     -->
    <!-- arrancaba a la altura de los títulos) y cualquier adorno del ListView se     -->
    <!-- pintaba encima de las barras. Aquí el encabezado tiene su propia fila, la    -->
    <!-- esquina sobre la barra se cubre con el mismo material del encabezado, y el   -->
    <!-- pozo hundido vive dentro de la celda de contenido, sin tocar las barras.     -->
    <Style x:Key="{x:Static GridView.GridViewScrollViewerStyleKey}" TargetType="{x:Type ScrollViewer}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Respaldo del encabezado, incluido el tramo sobrante tras  -->
                        <!-- la última columna: sin él esa zona mostraba fondo blanco. -->
                        <!-- Cruza las dos columnas: medido sobre la captura de SyncPro,-->
                        <!-- el encabezado corre a todo lo ancho y su filete inferior    -->
                        <!-- pasa por encima de la barra, que arranca debajo de él.      -->
                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                Background="{StaticResource ControlFaceBrush}"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{StaticResource HeaderRuleBrush}">
                            <Border BorderThickness="0,1,0,0"
                                    BorderBrush="{StaticResource BevelHighlightBrush}" />
                        </Border>

                        <!-- Fila de encabezados, desplazada en horizontal junto con el -->
                        <!-- contenido por el propio GridViewHeaderRowPresenter.        -->
                        <ScrollViewer Grid.Row="0" Grid.Column="0"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      Focusable="False">
                            <GridViewHeaderRowPresenter Margin="0"
                                Columns="{Binding Path=TemplatedParent.View.Columns, RelativeSource={RelativeSource TemplatedParent}}"
                                ColumnHeaderContainerStyle="{Binding Path=TemplatedParent.View.ColumnHeaderContainerStyle, RelativeSource={RelativeSource TemplatedParent}}"
                                ColumnHeaderTemplate="{Binding Path=TemplatedParent.View.ColumnHeaderTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                ColumnHeaderTemplateSelector="{Binding Path=TemplatedParent.View.ColumnHeaderTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}"
                                AllowsColumnReorder="{Binding Path=TemplatedParent.View.AllowsColumnReorder, RelativeSource={RelativeSource TemplatedParent}}"
                                ColumnHeaderContextMenu="{Binding Path=TemplatedParent.View.ColumnHeaderContextMenu, RelativeSource={RelativeSource TemplatedParent}}"
                                ColumnHeaderToolTip="{Binding Path=TemplatedParent.View.ColumnHeaderToolTip, RelativeSource={RelativeSource TemplatedParent}}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>

                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Grid.Row="1" Grid.Column="0"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                KeyboardNavigation.DirectionalNavigation="Local"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

                        <!-- Pozo hundido, solo sobre la celda de contenido. -->
                        <Border Grid.Row="1" Grid.Column="0"
                                BorderThickness="2,0,0,0"
                                BorderBrush="{StaticResource WellShadowBrush}"
                                IsHitTestVisible="False" />
                        <Border Grid.Row="1" Grid.Column="0"
                                BorderThickness="1,0,0,0"
                                BorderBrush="{StaticResource BevelShadowBrush}"
                                IsHitTestVisible="False" />
                        <Border Grid.Row="1" Grid.Column="0"
                                BorderThickness="0,0,1,1"
                                BorderBrush="{StaticResource BevelHighlightBrush}"
                                IsHitTestVisible="False" />

                        <!-- Arranca bajo el encabezado, no a su altura: en la captura
                             de referencia el filete del encabezado cruza por encima. -->
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Row="1" Grid.Column="1"
                                   Orientation="Vertical"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />

                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   Grid.Row="2" Grid.Column="0"
                                   Orientation="Horizontal"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />

                        <!-- Esquina entre las dos barras. -->
                        <Border Grid.Row="2" Grid.Column="1"
                                Background="{StaticResource ControlFaceBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="PlatinumListViewColumns" TargetType="{x:Type ListView}">
        <Border x:Name="Frame"
                BorderThickness="1"
                BorderBrush="{StaticResource TextBrush}"
                Background="{TemplateBinding Background}">
            <ScrollViewer Focusable="False"
                          Padding="0"
                          Style="{StaticResource {x:Static GridView.GridViewScrollViewerStyleKey}}">
                <!-- Sin redondeo de layout: es quien acomoda la pila de renglones y con
                                 él cada uno redondea sus orillas por separado, dejando una
                                 fila del fondo entre uno y otro. Invisible entre renglones
                                 blancos, pero bajo la banda de selección salía como una
                                 raya blanca pegada al divisor. -->
                            <ItemsPresenter SnapsToDevicePixels="True" UseLayoutRounding="False" />
            </ScrollViewer>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource BevelShadowBrush}" />
                <Setter TargetName="Frame" Property="Background" Value="{StaticResource ControlFaceDisabledBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="PlatinumListViewPlain" TargetType="{x:Type ListView}">
        <Border x:Name="Frame"
                BorderThickness="1"
                BorderBrush="{StaticResource TextBrush}"
                Background="{TemplateBinding Background}">
            <ScrollViewer Focusable="False" Padding="0">
                <!-- Sin redondeo de layout: es quien acomoda la pila de renglones y con
                                 él cada uno redondea sus orillas por separado, dejando una
                                 fila del fondo entre uno y otro. Invisible entre renglones
                                 blancos, pero bajo la banda de selección salía como una
                                 raya blanca pegada al divisor. -->
                            <ItemsPresenter SnapsToDevicePixels="True" UseLayoutRounding="False" />
            </ScrollViewer>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource BevelShadowBrush}" />
                <Setter TargetName="Frame" Property="Background" Value="{StaticResource ControlFaceDisabledBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PlatinumListView" TargetType="{x:Type ListView}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource ContentFaceBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource PlatinumListViewItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <!-- Con View de GridView: el filo negro exterior, y el pozo hundido más la    -->
        <!-- geometría de encabezados y barras en la plantilla del ScrollViewer de    -->
        <!-- GridView definida arriba.                                                -->
        <Setter Property="Template" Value="{StaticResource PlatinumListViewColumns}" />

        <!-- Sin View no hay columnas, así que la fila de encabezados sobra: se       -->
        <!-- cambia de plantilla. El cambio va por trigger dentro de este mismo       -->
        <!-- estilo y no por la llave GridView.GridViewStyleKey, que es un estilo de  -->
        <!-- tema: el estilo implícito de más abajo le gana en precedencia y la lista -->
        <!-- con columnas se quedaría sin encabezados.                                -->
        <Style.Triggers>
            <Trigger Property="View" Value="{x:Null}">
                <Setter Property="Template" Value="{StaticResource PlatinumListViewPlain}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ListView}" BasedOn="{StaticResource PlatinumListView}" />
    <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource PlatinumListViewItem}" />
    <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource PlatinumColumnHeader}" />

</ResourceDictionary>
