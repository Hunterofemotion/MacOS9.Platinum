<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MacOS9.Platinum.Controls"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Palette.xaml" />
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BorderGapMaskConverter x:Key="BorderGapMask" />
    <controls:SubtractConverter x:Key="RestarAncho" />

    <!-- Recuadro de agrupación: línea grabada —gris con su realce blanco al interior,-->
    <!-- el surco de dos tonos del Platinum original— con el título interrumpiéndola. -->
    <!-- El hueco del título se abre con una máscara de opacidad que también recorta  -->
    <!-- a la línea blanca (los hijos heredan la máscara del padre), así que funciona -->
    <!-- sobre cualquier fondo.                                                       -->
    <Style x:Key="PlatinumGroupBox" TargetType="{x:Type GroupBox}">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SystemFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="10,6,10,10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <!-- El mínimo de la columna elástica es lo que le deja
                                 sitio al marco a la derecha del título. Sin él, un
                                 título más ancho que su caja abre un hueco tan largo
                                 como el marco entero, el tramo derecho de la máscara
                                 queda con ancho negativo y desaparecen dos lados: el
                                 superior y el derecho. -->
                            <ColumnDefinition Width="*" MinWidth="28" />
                            <ColumnDefinition Width="8" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                        </Grid.RowDefinitions>

                        <Border x:Name="FrameLine"
                                Grid.Row="1" Grid.RowSpan="3"
                                Grid.ColumnSpan="4"
                                BorderThickness="1"
                                BorderBrush="{StaticResource FrameShadowBrush}">
                            <Border.OpacityMask>
                                <MultiBinding Converter="{StaticResource BorderGapMask}"
                                              ConverterParameter="9">
                                    <Binding ElementName="Header" Path="ActualWidth" />
                                    <Binding RelativeSource="{RelativeSource Self}" Path="ActualWidth" />
                                    <Binding RelativeSource="{RelativeSource Self}" Path="ActualHeight" />
                                </MultiBinding>
                            </Border.OpacityMask>

                            <!-- Realce interior del grabado; hereda la máscara del    -->
                            <!-- padre, así que respeta el hueco del título.           -->
                            <Border BorderThickness="1"
                                    BorderBrush="{StaticResource BevelHighlightBrush}" />
                        </Border>

                        <!-- El título va en negritas y el peso se fija en este
                             borde, no en el estilo: puesto arriba lo heredaría
                             también el contenido del grupo.

                             El ancho se limita al del recuadro y el texto se corta
                             con puntos suspensivos. Sin el tope, un título más
                             ancho que su caja deja el hueco de la máscara más largo
                             que el marco, el tramo derecho queda con ancho negativo
                             y desaparecen dos lados: el superior y el derecho. Un
                             título recortado dice que la caja se quedó corta; un
                             recuadro sin dos filos no dice nada. -->
                        <Border x:Name="Header"
                                Grid.Row="0" Grid.RowSpan="2"
                                Grid.Column="1"
                                Padding="4,0"
                                TextElement.FontWeight="Bold"
                                MaxWidth="{Binding ActualWidth,
                                           RelativeSource={RelativeSource TemplatedParent},
                                           Converter={StaticResource RestarAncho},
                                           ConverterParameter=44}">
                            <!-- El recorte va como plantilla de datos para cadenas y
                                 no como estilo implícito: un estilo declarado aquí
                                 no alcanza al TextBlock que arma el presentador, y
                                 el título terminaba cortado a media letra. La
                                 plantilla sí, que es el mecanismo que el presentador
                                 consulta. Con un título que no sea texto no aplica y
                                 se dibuja como antes. -->
                            <Border.Resources>
                                <DataTemplate DataType="{x:Type sys:String}">
                                    <TextBlock Text="{Binding}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </Border.Resources>
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>

                        <ContentPresenter Grid.Row="2"
                                          Grid.Column="1" Grid.ColumnSpan="2"
                                          Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Separador de diálogo: la misma línea grabada del recuadro —gris con realce   -->
    <!-- blanco debajo— de lado a lado. Los paneles de referencia (Sound, Keyboard)   -->
    <!-- lo usan entre secciones.                                                     -->
    <Style x:Key="PlatinumSeparator" TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="2">
                        <Border Height="1" VerticalAlignment="Top"
                                Background="{StaticResource FrameShadowBrush}" />
                        <Border Height="1" VerticalAlignment="Bottom"
                                Background="{StaticResource BevelHighlightBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Variante vertical del grabado, para barras de herramientas. -->
    <Style x:Key="PlatinumSeparatorVertical" TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Width="2">
                        <Border Width="1" HorizontalAlignment="Left"
                                Background="{StaticResource FrameShadowBrush}" />
                        <Border Width="1" HorizontalAlignment="Right"
                                Background="{StaticResource BevelHighlightBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource PlatinumGroupBox}" />
    <Style TargetType="{x:Type Separator}" BasedOn="{StaticResource PlatinumSeparator}" />

    <!-- ToolBar y StatusBar buscan el estilo de sus separadores por estas llaves, no -->
    <!-- por el implícito: sin los alias recibirían el tema del sistema.              -->
    <!-- El de ToolBar vive en ToolBar.xaml, junto a la barra: ahí lleva el aire     -->
    <!-- que necesita para no tocar los filos de la franja.                          -->
    <Style x:Key="{x:Static StatusBar.SeparatorStyleKey}"
           TargetType="{x:Type Separator}"
           BasedOn="{StaticResource PlatinumSeparatorVertical}" />

</ResourceDictionary>
