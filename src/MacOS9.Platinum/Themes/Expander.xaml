<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MacOS9.Platinum.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Palette.xaml" />
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Cabecera del panel plegable: el triángulo del Finder, el título subrayado y la -->
    <!-- línea grabada que corre hasta el filo derecho. Todo el renglón responde al     -->
    <!-- clic, no solo el triángulo, que es como se comportaban estos paneles.          -->
    <Style x:Key="PlatinumExpanderHeader" TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls:ArrowGlyph x:Name="Glyph"
                                             Grid.Column="0"
                                             Direction="Right"
                                             Steps="4"
                                             Fill="{StaticResource TextBrush}"
                                             Margin="0,0,5,0"
                                             VerticalAlignment="Center" />

                        <!-- El subrayado es del título, no de la cabecera: tiene que    -->
                        <!-- medir lo que mide el texto y no lo que mide el renglón.     -->
                        <!-- Las negritas se fijan aquí y no en el estilo del Expander:  -->
                        <!-- el contenido cuelga del control por el árbol lógico, así    -->
                        <!-- que un peso puesto arriba se le hereda entero.              -->
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontWeight="{StaticResource SystemFontWeight}"
                                   TextDecorations="Underline">
                            <ContentPresenter RecognizesAccessKey="True" />
                        </TextBlock>

                        <!-- Continuación grabada del renglón: cierra el título contra   -->
                        <!-- el filo, igual que el recuadro de agrupación.               -->
                        <Grid Grid.Column="2" Height="2" Margin="6,1,0,0"
                              VerticalAlignment="Center">
                            <Border Height="1" VerticalAlignment="Top"
                                    Background="{StaticResource FrameShadowBrush}" />
                            <Border Height="1" VerticalAlignment="Bottom"
                                    Background="{StaticResource BevelHighlightBrush}" />
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="controls:ArrowGlyph.Direction" Value="Down" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Panel plegable. No lleva animación al abrir ni al cerrar a propósito: el       -->
    <!-- original conmutaba de golpe, y el deslizamiento delata de inmediato que esto   -->
    <!-- no es Mac OS 9.                                                                -->
    <Style x:Key="PlatinumExpander" TargetType="{x:Type Expander}">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SystemFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="18,6,0,10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderSite"
                                      Style="{StaticResource PlatinumExpanderHeader}"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                        <ContentPresenter x:Name="ContentSite"
                                          Visibility="Collapsed"
                                          Margin="{TemplateBinding Padding}"
                                          Focusable="False" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource PlatinumExpander}" />

</ResourceDictionary>
