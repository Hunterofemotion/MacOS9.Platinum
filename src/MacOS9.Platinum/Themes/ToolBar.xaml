<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MacOS9.Platinum.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Palette.xaml" />
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Tecla de barra: icono arriba, rótulo debajo, sin marco en reposo. En Mac OS 9 -->
    <!-- la barra se lee como una fila de iconos sueltos sobre la cara de la ventana;  -->
    <!-- el relieve aparece solo al tocar.                                             -->
    <Style TargetType="{x:Type controls:PlatinumToolButton}">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontWeight" Value="{StaticResource SystemFontWeight}" />
        <Setter Property="FontSize" Value="{StaticResource SmallFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Padding" Value="10,4,10,3" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PlatinumToolButton}">
                    <Grid>
                        <!-- Cara y bisel viven apagados y se encienden por disparador:
                             así el reposo no pinta nada y la tecla no compite con el
                             icono. -->
                        <Border x:Name="Face" Background="Transparent" CornerRadius="2" />
                        <Border x:Name="BevelLight"
                                CornerRadius="2"
                                BorderThickness="1,1,0,0"
                                BorderBrush="{x:Null}" />
                        <Border x:Name="BevelDark"
                                CornerRadius="2"
                                BorderThickness="0,0,1,1"
                                BorderBrush="{x:Null}" />

                        <StackPanel Margin="{TemplateBinding Padding}">
                            <Image x:Name="Glyph"
                                   Source="{TemplateBinding Icon}"
                                   Width="{TemplateBinding IconSize}"
                                   Height="{TemplateBinding IconSize}"
                                   HorizontalAlignment="Center" />
                            <TextBlock x:Name="Label"
                                       Text="{TemplateBinding Text}"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ControlFaceBrush}" />
                            <Setter TargetName="BevelLight" Property="BorderBrush" Value="{StaticResource BevelHighlightBrush}" />
                            <Setter TargetName="BevelDark" Property="BorderBrush" Value="{StaticResource BevelShadowBrush}" />
                        </Trigger>

                        <!-- Al oprimir se hunde: el bisel se invierte, que es la misma
                             lectura que en el botón normal del tema. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ControlFacePressedBrush}" />
                            <Setter TargetName="BevelLight" Property="BorderBrush" Value="{StaticResource BevelDeepShadowBrush}" />
                            <Setter TargetName="BevelDark" Property="BorderBrush" Value="{x:Null}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Glyph" Property="Opacity" Value="0.4" />
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra de herramientas: franja sobre la cara de la ventana, cerrada abajo por  -->
    <!-- la línea grabada de dos tonos, la misma que separa la barra de estado.        -->
    <Style TargetType="{x:Type ToolBar}">
        <Setter Property="Background" Value="{StaticResource WindowFaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolBar}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Sin ToolBarPanel ni tecla de desbordamiento: la barra de
                             Mac OS 9 no se reacomoda ni esconde teclas. Lo que no
                             cabe se recorta, igual que en la barra de menús. -->
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="{TemplateBinding Padding}"
                                    IsItemsHost="True" />

                        <Border Grid.Row="1" Height="1"
                                Background="{StaticResource BevelShadowBrush}" />
                        <Border Grid.Row="1" Height="1" Margin="0,1,0,0"
                                Background="{StaticResource BevelHighlightBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Separador entre grupos de teclas: la línea grabada vertical, con aire arriba  -->
    <!-- y abajo para que no toque los filos de la franja.                             -->
    <Style x:Key="{x:Static ToolBar.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="5,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Width="2">
                        <Border Width="1" HorizontalAlignment="Left"
                                Background="{StaticResource BevelShadowBrush}" />
                        <Border Width="1" HorizontalAlignment="Right"
                                Background="{StaticResource BevelHighlightBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
