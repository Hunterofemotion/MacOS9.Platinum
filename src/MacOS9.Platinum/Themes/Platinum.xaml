        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Calendar.xaml" />
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/DateTimeField.xaml" />
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/ComboBox.xaml" />
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/ScrollBar.xaml" />
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/TabControl.xaml" />
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/ListView.xaml" />
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Menu.xaml" />
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Slider.xaml" />
