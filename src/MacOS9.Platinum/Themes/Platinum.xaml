        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Icons.xaml" />
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Window.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
