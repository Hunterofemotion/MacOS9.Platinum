<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MacOS9.Platinum.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Palette.xaml" />
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Franja de números: cara de contenido como el cuadro al que acompaña, la línea -->
    <!-- gris del marco separando las dos, y el número en la tipografía de contenido   -->
    <!-- un punto más chico, que es como se leía en el original.                       -->
    <Style TargetType="{x:Type controls:PlatinumLineGutter}">
        <Setter Property="Background" Value="{StaticResource ContentFaceBrush}" />
        <Setter Property="RuleBrush" Value="{StaticResource FrameShadowBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource ViewFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SmallFontSize}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
