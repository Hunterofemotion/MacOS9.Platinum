<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MacOS9.Platinum.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Palette.xaml" />
        <ResourceDictionary Source="/MacOS9.Platinum;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Tecla de una flechita. Cara plana sin bisel, como las de la barra de        -->
    <!-- desplazamiento: van embutidas en un marco que ya cierra por fuera.          -->
    <Style x:Key="PlatinumStepperArrow" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Grid>
                        <Border x:Name="Face" Background="{StaticResource ControlFaceBrush}" />
                        <ContentPresenter x:Name="Glyph"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ControlFacePressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Glyph" Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Las flechitas: dos teclas apiladas dentro de un marco negro, con un filo    -->
    <!-- entre ellas. Mismo grosor de marco que el campo de al lado para que las dos -->
    <!-- piezas se lean como una sola.                                               -->
    <Style TargetType="{x:Type controls:PlatinumStepper}">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="22" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PlatinumStepper}">
                    <Grid>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <RepeatButton x:Name="PART_Up"
                                          Grid.Row="0"
                                          Style="{StaticResource PlatinumStepperArrow}">
                                <controls:ArrowGlyph Direction="Up" Fill="{StaticResource TextBrush}" />
                            </RepeatButton>

                            <RepeatButton x:Name="PART_Down"
                                          Grid.Row="1"
                                          Style="{StaticResource PlatinumStepperArrow}">
                                <controls:ArrowGlyph Direction="Down" Fill="{StaticResource TextBrush}" />
                            </RepeatButton>

                            <Border Grid.Row="1" Height="1" VerticalAlignment="Top"
                                    Background="{StaticResource TextBrush}"
                                    IsHitTestVisible="False" />
                        </Grid>

                        <!-- El marco va encima, como en la barra de desplazamiento:
                             dibujado debajo, los hijos alcanzaban a sobrepintarlo. -->
                        <Border BorderThickness="1"
                                BorderBrush="{StaticResource TextBrush}"
                                IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campo de fecha u hora: el mismo pozo hundido del campo de texto, con las    -->
    <!-- flechitas pegadas a la derecha y sin separación, que es como venían en el   -->
    <!-- original.                                                                   -->
    <Style TargetType="{x:Type controls:PlatinumDateTimeField}">
        <Setter Property="FontFamily" Value="{StaticResource ViewFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource ViewFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PlatinumDateTimeField}">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Frame"
                                BorderThickness="1"
                                BorderBrush="{StaticResource TextBrush}"
                                Background="{StaticResource ContentFaceBrush}"
                                MinHeight="{TemplateBinding MinHeight}">
                            <Grid>
                                <StackPanel x:Name="PART_Segments"
                                            Orientation="Horizontal"
                                            Margin="{TemplateBinding Padding}"
                                            VerticalAlignment="Center" />
                                <Border BorderThickness="0,0,1,1"
                                        BorderBrush="{StaticResource BevelHighlightBrush}"
                                        IsHitTestVisible="False" />
                                <Border BorderThickness="1,1,0,0"
                                        BorderBrush="{StaticResource BevelShadowBrush}"
                                        IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <controls:PlatinumStepper x:Name="PART_Stepper"
                                                  Margin="4,0,0,0"
                                                  Height="{Binding ActualHeight, ElementName=Frame}" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource BevelShadowBrush}" />
                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource ControlFaceDisabledBrush}" />
                            <Setter TargetName="PART_Stepper" Property="IsEnabled" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
